{
  // Shared OpenCode configuration for the Dev Lab repo.
  // Docs: https://opencode.ai/v2/docs/config
  "$schema": "https://opencode.ai/config.json",

  // 1) Default model. Always use the "provider/model" form.
  "model": "opencode/deepseek-v4.1-flash-free",

  // 2) Trim tool output before it enters the context.
  //    Defaults are 2000 lines / 50 KiB. This is the strongest token-saving
  //    lever, because read/grep/shell output takes up most of the context.
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 24000,
  },

  // 3) Compact conversations earlier and keep a smaller tail.
  //    Defaults: keep.tokens = 15000, buffer = 10% of the context limit.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 8000 },
    "buffer": 12000,
  },

  // 4) Keep websearch for external lookups; uncomment the line below to turn it off.
  // "websearch": false,

  // 5) Large images are downscaled before being sent to the model.
  "media": {
    "image": {
      "auto_resize": true,
      "max_width": 1568,
      "max_height": 1568,
    },
  },

  // 6) Do not watch build directories (less background work, less file noise).
  "watcher": {
    "ignore": ["node_modules/**", "**/dist/**", "**/.next/**", "**/build/**"],
  },

  // 7) Agents: cap the number of model steps per turn, and let the explore
  //    subagent use the "low" variant to spend fewer reasoning tokens.
  "agents": {
    "build": {
      "steps": 40,
    },
    "explore": {
      "model": "opencode/deepseek-v4.1-flash-free#low",
    },
  },
}
