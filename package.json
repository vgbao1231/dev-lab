{
  "name": "dev-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dev Lab - hệ sinh thái blog và lab kỹ thuật",
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter portal dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter portal preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
