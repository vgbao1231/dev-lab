---
import type { CoverId } from '../data/covers';
import { isCoverId } from '../data/covers';

export type Props = {
  cover?: string;
  coverAlt?: string;
  title: string;
  typeLabel: string;
};

/*
 * The covers are hand-drawn SVGs inlined so they can read the lab tokens and
 * follow light/dark without a second file. They were moved from the portal when
 * the React articles moved here.
 */
const covers = import.meta.glob('../assets/covers/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

const { cover, coverAlt, title, typeLabel } = Astro.props;

const coverId: CoverId | undefined = cover && isCoverId(cover) ? cover : undefined;
const svg = coverId ? covers[`../assets/covers/${coverId}.svg`] : undefined;

const initials =
  title
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word.charAt(0))
    .join('')
    .toUpperCase() || 'RL';
---

{svg ? (
  <div class="post-cover" role="img" aria-label={coverAlt}>
    <Fragment set:html={svg} />
  </div>
) : (
  <div class="post-cover post-cover--fallback" aria-hidden="true">
    <span class="post-cover__initials">{initials}</span>
    <span class="post-cover__type">{typeLabel}</span>
  </div>
)}
