---
const label = 'Chuyển chế độ sáng/tối';
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label={label}
  aria-pressed="false"
  title={label}
>
  <svg
    class="theme-toggle__icon theme-toggle__icon--sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"></path>
  </svg>
  <svg
    class="theme-toggle__icon theme-toggle__icon--moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.2 8.2 0 0 1 9.5 4a8.2 8.2 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const media = globalThis.matchMedia('(prefers-color-scheme: dark)');
  const STORAGE_KEY = 'react-lab:mode';

  const currentMode = (): 'light' | 'dark' => (root.dataset.mode === 'dark' ? 'dark' : 'light');

  const sync = (): void => {
    const dark = currentMode() === 'dark';

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      button.setAttribute('aria-pressed', String(dark));
      button.setAttribute(
        'aria-label',
        dark ? 'Chuyển sang chế độ sáng' : 'Chuyển sang chế độ tối',
      );
    }
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !target.closest('[data-theme-toggle]')) return;

    const next = currentMode() === 'dark' ? 'light' : 'dark';
    root.dataset.mode = next;
    localStorage.setItem(STORAGE_KEY, next);
    sync();
  });

  media.addEventListener('change', (event) => {
    if (localStorage.getItem(STORAGE_KEY)) return;

    root.dataset.mode = event.matches ? 'dark' : 'light';
    sync();
  });

  sync();
</script>

<style>
  .theme-toggle__icon {
    display: none;
  }

  :global(:root[data-mode='light']) .theme-toggle__icon--moon,
  :global(:root[data-mode='dark']) .theme-toggle__icon--sun {
    display: block;
  }
</style>
