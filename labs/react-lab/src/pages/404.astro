---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Không tìm thấy trang — React Lab" description="Trang này không tồn tại.">
  <div class="page page--narrow">
    <section class="hero">
      <p class="hero__kicker">404</p>
      <h1 class="hero__title">Trang này không tồn tại.</h1>
      <p class="hero__lead">Có thể đường dẫn đã đổi khi React Lab chuyển sang cấu trúc mới.</p>
      <div class="hero__actions">
        <a class="button button--accent" href="/">
          Về trang chủ
        </a>
        <a class="button" href="/kien-thuc">
          Xem kiến thức
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
