---
import type { CollectionEntry } from 'astro:content';

import { formatPostDate, postTypeLabels } from '../data/content';

export type Props = {
  posts: CollectionEntry<'posts'>[];
};

const { posts } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li class="post-list__item">
      <a class="post-list__link" href={`/bai-viet/${post.id}`}>
        <span class="post-list__meta">
          {formatPostDate(post.data.date)} · {postTypeLabels[post.data.type]} · {post.data.lab}
          {post.data.tags.length > 0 && (
            <>
              {' · '}
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </>
          )}
        </span>
        <span class="post-list__title" style={`view-transition-name: vt-post-${post.id}`}>
          {post.data.title}
        </span>
        <span class="post-list__summary">{post.data.summary}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .post-list__item {
    border-top: 1px solid var(--color-border);
  }

  .post-list__item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  /*
   * Cả hàng là một link để vùng bấm rộng, nên không dùng gạch chân mọc dần;
   * phản hồi hover nằm ở màu tiêu đề (docs/DESIGN_SYSTEM.md mục 7.4).
   */
  .post-list__link {
    display: block;
    padding-block: 1rem;
    color: var(--color-text);
    background-image: none;
  }

  .post-list__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }

  .post-list__title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.4;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .post-list__link:hover .post-list__title {
    color: var(--color-link);
  }

  .post-list__summary {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
