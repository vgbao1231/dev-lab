---
import type { CollectionEntry } from 'astro:content';

import { formatPostDate, postTypeLabels } from '../data/content';

export type Props = {
  posts: CollectionEntry<'posts'>[];
};

const { posts } = Astro.props;
---

<ul class="post-list">
  {posts.map((post) => (
    <li class="post-list__item">
      <a class="post-list__title" href={`/bai-viet/${post.id}`}>
        {post.data.title}
      </a>
      <p class="post-list__summary">{post.data.summary}</p>
      <p class="meta">
        {formatPostDate(post.data.date)} · {postTypeLabels[post.data.type]} · {post.data.lab}
        {post.data.tags.length > 0 && (
          <>
            {' · '}
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </>
        )}
      </p>
    </li>
  ))}
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .post-list__item {
    border-top: 1px solid var(--color-border);
    padding-block: 1.25rem;
  }

  .post-list__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text);
  }

  .post-list__summary {
    margin: 0.25rem 0 0.5rem;
  }

  .post-list__item .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
  }

  .tag {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.05rem 0.4rem;
  }
</style>
