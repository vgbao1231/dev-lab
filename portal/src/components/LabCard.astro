---
import { type Lab, labStatusLabel } from '../data/labs';

export type Props = {
  lab: Lab;
};

const { lab } = Astro.props;
const isLink = Boolean(lab.href);
---

<article class:list={['lab-card', isLink && 'lab-card--link']}>
  <!-- Cover image area: màu từ coverBg trong data (decorative, màu design cố định) -->
  <div class="lab-card__cover" style={lab.coverBg ? `background: ${lab.coverBg}` : undefined}></div>

  <div class="lab-card__body">
    <!-- Category chip -->
    {lab.category && <span class="lab-card__chip">{lab.category}</span>}

    <h3 class="lab-card__title">
      {isLink ? (
        <a class="lab-card__link" href={lab.href}>
          {lab.name}
        </a>
      ) : (
        lab.name
      )}
    </h3>

    <p class="lab-card__summary">{lab.summary}</p>

    <!-- Meta line: trạng thái lab với calendar icon -->
    <p class="lab-card__meta">
      <svg
        aria-hidden="true"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      >
        <rect x="4" y="5" width="16" height="15" rx="2"></rect>
        <path d="M4 10h16M9 3v4M15 3v4"></path>
      </svg>
      {labStatusLabel[lab.status]}
    </p>
  </div>
</article>

<style>
  /*
   * Card lab: border-radius 12px theo reference, padding 10px, gap 10px,
   * nền surface rất mờ (rgba(255,255,255,.025) trong ref).
   * Hover nhấc 3px + đổi viền accent.
   */
  .lab-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 10px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.3s,
      background 0.3s,
      transform 0.35s cubic-bezier(0.22, 0.8, 0.3, 1);
  }

  /*
   * Chỉ lab đã có địa chỉ mới là affordance bấm được: viền đổi sang màu accent
   * và card nhấc lên 3px (theo reference translateY(-3px), border-color accent rgba).
   */
  .lab-card--link:hover,
  .lab-card--link:focus-within {
    border-color: rgba(157, 187, 144, 0.42);
    background: color-mix(in oklab, var(--color-surface) 100%, white 3%);
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .lab-card {
      transition: none;
    }
  }

  /* Cover: gradient decorative từ data.coverBg. Bo góc 8px theo reference. */
  .lab-card__cover {
    height: 72px;
    border-radius: 8px;
    background-color: var(--color-surface);
    /* coverBg applied inline */
  }

  .lab-card__body {
    padding: 0 6px 6px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /*
   * Category chip: 0.6875rem (11px) font, rgba(125,154,114,.16) background, #bcd1ad text per the reference.
   */
  .lab-card__chip {
    align-self: flex-start;
    font-size: 0.6875rem;
    padding: 3px 8px;
    border-radius: 5px;
    background: rgba(125, 154, 114, 0.16);
    color: #bcd1ad;
  }

  /*
   * Title: Lora, serif, --text-sm (16px), weight 500 per the reference.
   */
  .lab-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    font-weight: 500;
    color: #efe9d6;
    margin: 0;
  }

  .lab-card__link {
    color: inherit;
    /* Card đã có phản hồi hover riêng, không cần gạch chân. */
    background-image: none;
  }

  /* Link trải phủ cả card; DOM vẫn giữ cấu trúc h3 > a. */
  .lab-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  /* Summary: 0.78125rem (12.5px), line-height 1.6, #9a978a, weight 300 per the reference. */
  .lab-card__summary {
    margin: 0;
    font-size: 0.78125rem;
    line-height: 1.6;
    color: #9a978a;
    font-weight: 300;
  }

  /* Meta line: calendar icon + status label, --text-2xs (12px) per the reference. */
  .lab-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-2xs);
    color: #9a978a;
    margin: 2px 0 0;
  }
</style>
