---
import { type Lab, labStatusLabel } from '../data/labs';

export type Props = {
  lab: Lab;
};

const { lab } = Astro.props;
const isLink = Boolean(lab.href);
---

<article class:list={['lab-card', isLink && 'lab-card--link']}>
  <!-- Cover image area: màu từ coverBg trong data (decorative, màu design cố định) -->
  <div class="lab-card__cover" style={lab.coverBg ? `background: ${lab.coverBg}` : undefined}></div>

  <div class="lab-card__body">
    <!-- Category chip -->
    {lab.category && <span class="lab-card__chip">{lab.category}</span>}

    <h3 class="lab-card__title">
      {isLink ? (
        <a class="lab-card__link" href={lab.href}>
          {lab.name}
        </a>
      ) : (
        lab.name
      )}
    </h3>

    <p class="lab-card__summary">{lab.summary}</p>

    <!-- Meta line: trạng thái lab với calendar icon -->
    <p class="lab-card__meta">
      <svg
        aria-hidden="true"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      >
        <rect x="4" y="5" width="16" height="15" rx="2"></rect>
        <path d="M4 10h16M9 3v4M15 3v4"></path>
      </svg>
      {labStatusLabel[lab.status]}
    </p>
  </div>
</article>

<style>
  /*
   * Card lab: border-radius 12px theo reference, padding 10px, gap 10px,
   * nền --color-surface. Hover nhấc 3px + đổi viền accent.
   */
  .lab-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 10px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard);
  }

  /*
   * Chỉ lab đã có địa chỉ mới là affordance bấm được: viền đổi sang màu accent
   * và card nhấc lên 3px (theo reference translateY(-3px)).
   * Tách hover (thiết bị có con trỏ thật) khỏi focus-within (bàn phím) để cảm ứng
   * không dính trạng thái hover.
   */
  @media (hover: hover) and (pointer: fine) {
    .lab-card--link:hover {
      border-color: color-mix(in oklab, var(--color-accent) 42%, transparent);
      background-color: color-mix(in oklab, var(--color-surface) 97%, var(--color-text));
      transform: translateY(-3px);
    }
  }

  .lab-card--link:focus-within {
    border-color: color-mix(in oklab, var(--color-accent) 42%, transparent);
    background-color: color-mix(in oklab, var(--color-surface) 97%, var(--color-text));
    transform: translateY(-3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .lab-card {
      transition: none;
    }
  }

  /* Cover: gradient decorative từ data.coverBg, cùng tỉ lệ 16:9 với cover bài viết. */
  .lab-card__cover {
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    background-color: var(--color-surface);
    /* coverBg applied inline */
  }

  .lab-card__body {
    padding: 0 6px 6px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /*
   * Category chip: --text-2xs, accent tint derived from the token so it follows
   * theme × mode instead of using a literal green.
   */
  .lab-card__chip {
    align-self: flex-start;
    font-size: var(--text-2xs);
    padding: 3px 8px;
    border-radius: 5px;
    background: color-mix(in oklab, var(--color-accent) 16%, transparent);
    color: color-mix(in oklab, var(--color-accent) 82%, var(--color-text));
  }

  /*
   * Title: Lora, serif, --text-sm (16px), weight 500 per the reference.
   */
  .lab-card__title {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
  }

  .lab-card__link {
    color: inherit;
    /* Card đã có phản hồi hover riêng, không cần gạch chân. */
    background-image: none;
  }

  /* Link trải phủ cả card; DOM vẫn giữ cấu trúc h3 > a. */
  .lab-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  /* Summary: --text-2xs, line-height 1.6, muted, weight 300 per the reference. */
  .lab-card__summary {
    margin: 0;
    font-size: var(--text-2xs);
    line-height: 1.6;
    color: var(--color-text-muted);
    font-weight: 300;
  }

  /* Meta line: calendar icon + status label, --text-2xs (12px) per the reference. */
  .lab-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
    margin: 2px 0 0;
  }
</style>
