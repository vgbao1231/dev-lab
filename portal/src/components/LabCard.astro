---
import { type Lab, labStatusLabel } from '../data/labs';

export type Props = {
  lab: Lab;
};

const { lab } = Astro.props;
const isLink = Boolean(lab.href);
---

<article class:list={['lab-card', isLink && 'lab-card--link']}>
  <div class="lab-card__heading">
    <h3 class="lab-card__title">
      {isLink ? (
        <a class="lab-card__link" href={lab.href}>
          {lab.name}
        </a>
      ) : (
        lab.name
      )}
    </h3>
    <p class="meta lab-card__status">
      <span
        class:list={['lab-card__dot', lab.status === 'running' && 'lab-card__dot--on']}
        aria-hidden="true"
      ></span>
      {labStatusLabel[lab.status]}
    </p>
  </div>

  <p class="lab-card__summary">{lab.summary}</p>

  <ul class="lab-card__stack">
    {lab.stack.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</article>

<style>
  .lab-card {
    position: relative;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.125rem;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  /*
   * Chỉ lab đã có địa chỉ mới là affordance bấm được: viền đổi sang màu accent
   * và card nhấc lên 1px (docs/DESIGN_SYSTEM.md mục 6).
   */
  .lab-card--link:hover,
  .lab-card--link:focus-within {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }

  .lab-card__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .lab-card__title {
    font-size: var(--text-lg);
    margin: 0;
  }

  .lab-card__link {
    color: var(--color-text);
    /* Card đã có phản hồi hover riêng, không cần gạch chân. */
    background-image: none;
  }

  /* Link trải phủ cả card; DOM vẫn giữ cấu trúc h3 > a. */
  .lab-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .lab-card__status {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
  }

  /* Trạng thái không chỉ phân biệt bằng màu: luôn kèm nhãn chữ */
  .lab-card__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    border: 1px solid var(--color-text-muted);
  }

  .lab-card__dot--on {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .lab-card__summary {
    margin: 0.5rem 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .lab-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }

  .lab-card__stack li {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.1rem 0.4rem;
  }
</style>
