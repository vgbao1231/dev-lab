---
import type { CollectionEntry } from 'astro:content';

import Icon from './Icon.astro';
import PostCover from './PostCover.astro';
import { formatPostDate, postTypeLabels } from '../data/content';
import { estimateReadingMinutes } from '../lib/reading';

export type Props = {
  post: CollectionEntry<'posts'>;
};

const { post } = Astro.props;
const readingMinutes = estimateReadingMinutes(post.body);
const titleViewTransitionName = `vt-post-${post.id}`;
---

<article class="post-card">
  <div class="post-card__cover">
    <PostCover
      cover={post.data.cover}
      coverAlt={post.data.coverAlt}
      title={post.data.title}
      typeLabel={postTypeLabels[post.data.type]}
    />
  </div>

  <div class="post-card__body">
    <p class="post-card__meta meta">
      {postTypeLabels[post.data.type]} · {post.data.lab}
    </p>

    <h2 class="post-card__title" style={`view-transition-name: ${titleViewTransitionName}`}>
      <a class="post-card__title-link" href={`/bai-viet/${post.id}`}>
        {post.data.title}
      </a>
    </h2>

    <p class="post-card__summary">{post.data.summary}</p>

    <ul class="post-card__tags" aria-label="Tag của bài viết">
      {post.data.tags.map((tag) => (
        <li class="tag">{tag}</li>
      ))}
    </ul>

    <div class="post-card__footer meta">
      <span class="post-card__fact">
        <Icon name="calendar" size={14} />
        {formatPostDate(post.data.date)}
      </span>
      <span class="post-card__fact">
        <Icon name="clock" size={14} />
        {readingMinutes} phút đọc
      </span>
    </div>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      transform var(--duration-base) var(--ease-standard);
  }

  .post-card__cover {
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .post-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0.9rem 1rem 1rem;
  }

  .post-card__meta {
    margin: 0 0 0.35rem;
    font-size: var(--text-2xs);
  }

  .post-card__title {
    margin: 0 0 0.45rem;
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  /*
   * Cả card là vùng bấm của link tiêu đề nhờ pseudo-element phủ lên. Không đặt
   * <a> quanh cả card để chỉ có một link trong cây accessibility.
   */
  .post-card__title-link {
    color: var(--color-text);
    background-image: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .post-card__title-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .post-card__summary {
    margin: 0 0 0.75rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0 0 0.9rem;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-muted);
  }

  .post-card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 0.75rem;
    margin-top: auto;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-border);
    font-size: var(--text-2xs);
  }

  .post-card__fact {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .post-card:hover {
      border-color: color-mix(in oklab, var(--color-accent) 55%, var(--color-border));
      transform: translateY(-2px);
    }

    .post-card:hover .post-card__title-link {
      color: var(--color-link);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-card {
      transition: none;
    }

    .post-card:hover {
      transform: none;
    }
  }
</style>
