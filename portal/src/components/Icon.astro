---
import type { IconName } from '../data/icons';

/**
 * Bộ icon dùng chung — docs/design/components.md, mục Icon.
 *
 * Tất cả icon cùng một ngôn ngữ: viewBox 24, nét 1.5px, đầu nét tròn, màu lấy từ
 * `currentColor`. Icon đặc (GitHub) dùng `fill` thay vì `stroke` để giữ đúng hình.
 * Danh mục tên icon ở `src/data/icons.ts`.
 */
export type Props = {
  name: IconName;
  size?: number;
  class?: string;
  /** Có nhãn thì icon được đọc như ảnh; không có thì ẩn với screen reader. */
  label?: string;
};

const icons: Record<IconName, { paths: string; filled?: boolean }> = {
  leaf: {
    paths:
      '<path d="M20 3c-7 0-12 3.5-12 9a6 6 0 0 0 6 6c5.5 0 9-5 9-15Z"/><path d="M4 21c1.5-5.5 4.5-9 9-11"/>',
  },
  search: {
    paths: '<circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/>',
  },
  sun: {
    paths:
      '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  },
  moon: {
    paths: '<path d="M20 15.5A8.5 8.5 0 0 1 8.5 4a8.5 8.5 0 1 0 11.5 11.5Z"/>',
  },
  monitor: {
    paths: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  },
  flask: {
    paths:
      '<path d="M9 3h6M10 3v6l-5 9.5A2 2 0 0 0 6.8 21h10.4a2 2 0 0 0 1.8-2.5L14 9V3"/><path d="M8 15h8"/>',
  },
  'file-text': {
    paths: '<path d="M6 2h8l4 4v16H6z"/><path d="M14 2v4h4M9 11h6M9 15h6M9 19h4"/>',
  },
  calendar: {
    paths: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/>',
  },
  clock: {
    paths: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  },
  github: {
    filled: true,
    paths:
      '<path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 2.9-.39c.98 0 1.97.13 2.9.39 2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.41-5.25 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"/>',
  },
  x: {
    paths: '<path d="M6 6l12 12M18 6 6 18"/>',
  },
  enter: {
    paths: '<path d="M20 4v7a4 4 0 0 1-4 4H4"/><path d="m9 10-5 5 5 5"/>',
  },
  'arrow-up': {
    paths: '<path d="M12 20V4M6 10l6-6 6 6"/>',
  },
  'arrow-down': {
    paths: '<path d="M12 4v16M6 14l6 6 6-6"/>',
  },
};

const { name, size = 18, class: className, label } = Astro.props;
const icon = icons[name];
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? 'none' : 'currentColor'}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  focusable="false"
>
  {label && <title>{label}</title>}
  <Fragment set:html={icon.paths} />
</svg>
