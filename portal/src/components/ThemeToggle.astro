---
import { availableThemes } from '../data/themes';

// Hai trục độc lập: mode (sáng / tối / hệ thống) và theme (Minimalist Editorial, ...).
// Giá trị được ghi vào <html data-mode data-theme> và lưu ở localStorage.
// Bộ chọn theme chỉ hiện khi có từ hai theme trở lên — xem docs/DESIGN_SYSTEM.md mục 1.
const showThemeSelector = availableThemes.length > 1;
---

<div class="theme-toggle">
  <fieldset class="theme-toggle__group">
    <legend class="meta">Chế độ</legend>
    <button type="button" data-mode-set="light">
      Sáng
    </button>
    <button type="button" data-mode-set="dark">
      Tối
    </button>
    <button type="button" data-mode-set="system">
      Hệ thống
    </button>
  </fieldset>

  {showThemeSelector && (
    <fieldset class="theme-toggle__group">
      <legend class="meta">Theme</legend>
      {availableThemes.map((theme) => (
        <button type="button" data-theme-set={theme.id}>
          {theme.label}
        </button>
      ))}
    </fieldset>
  )}
</div>

<script>
  const STORAGE_MODE = 'dev-lab:mode';
  const STORAGE_THEME = 'dev-lab:theme';

  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Đổi theme/mode chủ động chạy trong một view transition để cross-fade màu.
  const withViewTransition = (update: () => void): void => {
    if (!document.startViewTransition || prefersReducedMotion) {
      update();
      return;
    }
    try {
      document.startViewTransition(update);
    } catch {
      // Có thể trùng với một view transition khác (điều hướng đang chạy).
      update();
    }
  };

  const readModePreference = (): 'light' | 'dark' | 'system' => {
    const value = root.dataset.modePreference;
    return value === 'light' || value === 'dark' ? value : 'system';
  };

  const applyMode = (preference: 'light' | 'dark' | 'system') => {
    const mode = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
    root.dataset.modePreference = preference;
    root.dataset.mode = mode;
  };

  const applyTheme = (theme: string) => {
    root.dataset.theme = theme;
  };

  /*
   * Luôn truy vấn DOM tại thời điểm gọi: ClientRouter thay nút theme khi chuyển
   * trang, nên không được giữ tham chiếu tới nút của trang cũ.
   */
  const syncPressedState = () => {
    const preference = readModePreference();
    const theme = root.dataset.theme ?? '';

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-mode-set]')) {
      button.setAttribute('aria-pressed', String(button.dataset.modeSet === preference));
    }

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-set]')) {
      button.setAttribute('aria-pressed', String(button.dataset.themeSet === theme));
    }
  };

  /*
   * Uỷ quyền sự kiện ở document thay vì gắn vào từng nút: listener trên document
   * tồn tại qua mọi lần chuyển trang, nên nút theme vẫn hoạt động sau điều hướng.
   */
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const modeButton = target.closest<HTMLButtonElement>('[data-mode-set]');
    if (modeButton) {
      const value = modeButton.dataset.modeSet;
      if (value !== 'light' && value !== 'dark' && value !== 'system') return;

      withViewTransition(() => {
        applyMode(value);
        localStorage.setItem(STORAGE_MODE, value);
        syncPressedState();
      });
      return;
    }

    const themeButton = target.closest<HTMLButtonElement>('[data-theme-set]');
    if (themeButton) {
      const value = themeButton.dataset.themeSet;
      if (!value) return;

      withViewTransition(() => {
        applyTheme(value);
        localStorage.setItem(STORAGE_THEME, value);
        syncPressedState();
      });
    }
  });

  // Chỉ theo dõi hệ thống khi người dùng chọn "Hệ thống"
  media.addEventListener('change', () => {
    if (readModePreference() === 'system') {
      applyMode('system');
      syncPressedState();
    }
  });

  /*
   * Astro ClientRouter thay toàn bộ attribute của <html> bằng bản của trang mới
   * (swapRootAttributes), nên data-theme/data-mode do JS gán sẽ bị xoá và theme bị
   * reset sau khi chuyển trang. Chép chúng sang document mới để giữ nguyên.
   * Cờ .motion-ready thì cố ý không chép: trang mới không chạy lại entrance.
   */
  document.addEventListener('astro:before-swap', (event) => {
    const nextRoot = event.newDocument.documentElement;
    if (root.dataset.theme) nextRoot.dataset.theme = root.dataset.theme;
    if (root.dataset.mode) nextRoot.dataset.mode = root.dataset.mode;
    if (root.dataset.modePreference) nextRoot.dataset.modePreference = root.dataset.modePreference;
  });

  // Sau mỗi lần chuyển trang, nút theme được render lại: đặt lại aria-pressed.
  // astro:page-load cũng bắn ở lần tải đầu tiên.
  document.addEventListener('astro:page-load', syncPressedState);

  syncPressedState();
</script>

<style>
  .theme-toggle {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .theme-toggle__group {
    display: flex;
    gap: 0.25rem;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.5rem;
    margin: 0;
  }

  .theme-toggle__group legend {
    padding-inline: 0.25rem;
  }

  .theme-toggle__group button {
    background: none;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    padding: 0.15rem 0.4rem;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .theme-toggle__group button[aria-pressed='true'] {
    border-color: var(--color-accent);
    color: var(--color-text);
  }
</style>
