<script>
  /*
   * Parallax trang chủ: blobs + dots + SVG cây mầm di chuyển theo con trỏ chuột và scroll.
   * Port chuẩn xác từ logic renderVals() trong design-reference/home-html/Main.dc.html.
   *
   * Coordinates: nx, ny chuẩn hoá từ -0.5 tới 0.5 (clientX / innerWidth - 0.5).
   * Tắt hoàn toàn khi prefers-reduced-motion: reduce.
   */
  const initParallax = () => {
    const reduce =
      typeof window !== 'undefined' &&
      window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;

    const blobA = document.getElementById('blob-a');
    if (!blobA) return;

    const blobB = document.getElementById('blob-b');
    const blobC = document.getElementById('blob-c');
    const blobD = document.getElementById('blob-d');
    const blobE = document.getElementById('blob-e');
    const blobF = document.getElementById('blob-f');
    const fxSprout = document.getElementById('fx-sprout');
    const fxNote = document.getElementById('fx-note');
    const dots = Array.from(document.querySelectorAll<HTMLElement>('.home-dot'));

    let nx = 0;
    let ny = 0;
    let sy = window.scrollY || 0;

    const t = (x: number, y: number) => `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;

    const tb = (x: number, y: number, r: number, sc: number) =>
      `${t(x, y)} rotate(${r.toFixed(1)}deg) scale(${sc.toFixed(3)})`;

    let raf = 0;
    const apply = () => {
      const m = Math.hypot(nx, ny);

      if (blobA)
        blobA.style.transform = tb(nx * -42, ny * -28 - sy * 0.08, nx * -3.5, 1 + m * 0.07);
      if (blobB) blobB.style.transform = tb(nx * 52, ny * 36 - sy * 0.14, ny * 4.5, 1 + m * 0.09);
      if (blobC) blobC.style.transform = tb(nx * -56, ny * 32 - sy * 0.05, nx * 4, 1 + m * 0.08);
      if (blobD) blobD.style.transform = tb(nx * 36, ny * -24 - sy * 0.12, nx * -4.5, 1 + m * 0.07);
      if (blobE) blobE.style.transform = tb(nx * 48, ny * 28 - sy * 0.06, ny * -3, 1 + m * 0.08);
      if (blobF) blobF.style.transform = tb(nx * -40, ny * -20 - sy * 0.05, nx * 3, 1 + m * 0.07);

      if (fxSprout) fxSprout.style.transform = t(nx * -18, ny * -12 - sy * 0.05);
      if (fxNote) fxNote.style.transform = t(nx * 14, ny * 10);

      dots.forEach((dot) => {
        const p = Number(dot.dataset.parallax || 1);
        dot.style.transform = t(nx * p * -100, ny * p * -80 - sy * p * 0.06);
      });

      raf = 0;
    };

    const schedule = () => {
      if (!raf) raf = requestAnimationFrame(apply);
    };

    const onMove = (e: MouseEvent) => {
      const w = window.innerWidth || 1440;
      const h = window.innerHeight || 800;
      nx = e.clientX / w - 0.5;
      ny = e.clientY / h - 0.5;
      schedule();
    };

    const onScroll = () => {
      sy = window.scrollY || 0;
      schedule();
    };

    window.addEventListener('mousemove', onMove, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });
    schedule();
  };

  initParallax();
  document.addEventListener('astro:page-load', initParallax);
</script>
