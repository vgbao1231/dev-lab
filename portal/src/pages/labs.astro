---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LabCard from '../components/LabCard.astro';
import { labs } from '../data/labs';
---

<BaseLayout title="Labs — Dev Lab" description="Danh sách các lab kỹ thuật của Dev Lab.">
  <section class="section container" data-animate>
    <div class="measure">
      <div class="page-head">
        <span class="page-head__icon">
          <Icon name="flask" size={20} />
        </span>
        <h1 style="view-transition-name: page-title">Labs</h1>
      </div>
      <p class="lead">
        Mỗi lab tập trung vào một công nghệ hoặc một lĩnh vực, có stack và cách triển khai riêng.
      </p>
    </div>

    <div class="lab-grid">
      {labs.map((lab) => (
        <LabCard lab={lab} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .page-head h1 {
    margin: 0;
  }

  .page-head__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    border-radius: var(--radius-lg);
    background-color: color-mix(in oklab, var(--color-accent) 14%, transparent);
    color: var(--color-accent);
  }

  .lab-grid {
    margin-top: 2rem;
  }
</style>
