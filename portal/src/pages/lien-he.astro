---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Liên hệ — Dev Lab" description="Thông tin liên hệ với tác giả Dev Lab.">
  <section class="section container">
    <h1>Liên hệ</h1>
    <p class="lead">
      Góp ý về nội dung, báo lỗi trong bài viết hoặc trao đổi về kỹ thuật đều được hoan nghênh.
    </p>

    <ul class="contact-list">
      <li>
        <span class="meta">GitHub</span>
        <a href="https://github.com/vgbao1231" rel="me">
          github.com/vgbao1231
        </a>
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .contact-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .contact-list li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: baseline;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
  }
</style>
